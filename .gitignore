# Repo-wide ignores only. Language-specific patterns live beside the code they
# govern: backend/.gitignore for Python, frontend/.gitignore for Node.
#
# Two rules keep this honest. A .gitignore applies to its own directory and
# below, so putting a pattern next to the code it belongs to is the first line
# of defence. The second is anchoring: an unanchored pattern matches at every
# depth, which is what you want for node_modules and not what you want for a
# name like lib, build or dist. An unanchored `lib/` here once swallowed the
# whole of frontend/src/lib.

# OS
.DS_Store
Thumbs.db

# Editors
*.swp
*~

# Secrets
.env
.env.*
!.env.example

# Logs
*.log

# Dependencies. Unanchored on purpose: unambiguous at any depth.
node_modules/

# ---- greek history atlas ----
# Raw boundary downloads: regenerate with `make fetch`. The built geometry in
# data/ is committed on purpose, as is the API export in frontend/static/api/.
data/raw/
