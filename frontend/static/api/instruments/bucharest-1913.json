{"id":"bucharest-1913","name":{"en":"Treaty of Bucharest","el":"Συνθήκη του Βουκουρεστίου"},"kind":"treaty","signed":"1913-08-10","parties":["gr-kingdom","serbia","montenegro","romania","bulgaria"],"summary":{"en":"Ended the Second Balkan War and divided Ottoman Macedonia. Greece received southern Macedonia with Thessaloniki and Kavala; Bulgaria kept an outlet to the Aegean in Western Thrace.\n","el":"Τερμάτισε τον Β΄ Βαλκανικό Πόλεμο και μοίρασε την οθωμανική Μακεδονία. Η Ελλάδα πήρε τη νότια Μακεδονία με τη Θεσσαλονίκη και την Καβάλα· η Βουλγαρία κράτησε διέξοδο στο Αιγαίο μέσα από τη Δυτική Θράκη.\n"},"text_url":"https://en.wikisource.org/wiki/Treaty_of_Bucharest","review":null,"sources":[{"id":"hall-2000","kind":"book","title":"The Balkan Wars 1912-1913: Prelude to the First World War","author":"Richard C. Hall","year":2000,"publisher":"Routledge","url":null,"isbn":null,"doi":null,"accessed":null,"locator":null}],"control":[{"atom":"epirus","polity":"gr-kingdom","kind":"sovereign","from":"1913-08-10","to":null,"instrument":"bucharest-1913","note":null},{"atom":"macedonia-west","polity":"gr-kingdom","kind":"sovereign","from":"1913-08-10","to":null,"instrument":"bucharest-1913","note":null},{"atom":"macedonia-central","polity":"gr-kingdom","kind":"sovereign","from":"1913-08-10","to":null,"instrument":"bucharest-1913","note":null},{"atom":"macedonia-east","polity":"gr-kingdom","kind":"sovereign","from":"1913-08-10","to":null,"instrument":"bucharest-1913","note":null},{"atom":"thrace-west","polity":"bulgaria","kind":"sovereign","from":"1913-08-10","to":"1920-05-27","instrument":"bucharest-1913","note":null}],"events":[{"id":"treaty-of-bucharest-1913","title":{"en":"The Treaty of Bucharest","el":"Η Συνθήκη του Βουκουρεστίου"},"period":["1913-08-10","1913-08-11"]}]}