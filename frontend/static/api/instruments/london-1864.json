{"id":"london-1864","name":{"en":"Treaty of London","el":"Συνθήκη του Λονδίνου"},"kind":"treaty","signed":"1864-03-29","parties":["britain","france","russia","gr-kingdom"],"summary":{"en":"Britain ceded the Ionian Islands to Greece on condition of their perpetual neutrality. The transfer took effect on 2 June 1864.\n","el":null},"sources":[{"id":"clogg-2021","kind":"book","title":"A Concise History of Greece","author":"Richard Clogg","year":2021,"publisher":"Cambridge University Press","url":null,"locator":null}],"control":[{"atom":"ionian","polity":"gr-kingdom","kind":"sovereign","from":"1864-06-02","to":null,"instrument":"london-1864","note":null}],"events":[{"id":"union-of-the-ionian-islands","title":{"en":"The Union of the Ionian Islands","el":null},"period":["1864-06-02","1864-06-03"]}]}