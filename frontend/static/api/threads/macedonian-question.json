{"id":"macedonian-question","name":{"en":"The Macedonian question","el":"Το Μακεδονικό"},"summary":{"en":"A three-sided struggle for a province, the partition that ended it, and the neighbours on its northern edge who kept the frontier in question for a generation after.\n","el":"Ένας τριγωνικός αγώνας για μια επαρχία, η διανομή που τον τερμάτισε και οι γείτονες στο βόρειο άκρο της που κράτησαν τα σύνορα υπό αμφισβήτηση για μια γενιά ακόμη.\n"},"events":[{"id":"macedonian-struggle","title":{"en":"The Macedonian Struggle","el":"Ο Μακεδονικός Αγώνας"},"period":["1904-01-01","1908-07-25"],"significance":3},{"id":"liberation-of-thessaloniki","title":{"en":"The liberation of Thessaloniki","el":"Η απελευθέρωση της Θεσσαλονίκης"},"period":["1912-11-08","1912-11-11"],"significance":4},{"id":"treaty-of-bucharest-1913","title":{"en":"The Treaty of Bucharest","el":"Η Συνθήκη του Βουκουρεστίου"},"period":["1913-08-10","1913-08-11"],"significance":5},{"id":"incident-at-petrich","title":{"en":"The Incident at Petrich","el":"Το επεισόδιο του Πετριτσίου"},"period":["1925-10-19","1925-10-30"],"significance":2},{"id":"closing-of-the-yugoslav-border","title":{"en":"Tito Closes the Yugoslav Border","el":"Το κλείσιμο των γιουγκοσλαβικών συνόρων"},"period":["1949-07-01","1949-08-01"],"significance":3}],"span":["1904-01-01","1949-07-01"]}