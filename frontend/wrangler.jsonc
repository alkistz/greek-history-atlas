{
	// Cloudflare Workers with static assets. Pages still runs, but Cloudflare
	// directs new projects here, and a static site is the simplest case of it:
	// no Worker script at all, just the built directory.
	//
	// The name must match the Worker's name in the dashboard or a git-connected
	// build fails.
	"name": "greek-history-atlas",
	"compatibility_date": "2026-09-20",
	"assets": {
		"directory": "./build",
		// Every page the app has is a real file: scripts/shells.mjs writes one per
		// route after the build, with that page's title and preview tags. Anything
		// else is not a page, so it gets 404.html (the app shell, which renders the
		// error page) with a real 404 status.
		"not_found_handling": "404-page"
	}
}
